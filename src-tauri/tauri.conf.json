{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParamSnapshotViewer",
  "version": "0.1.0",
  "identifier": "app.paramsnapshotviewer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "参数快照查看器",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "离线查看设备轮询参数快照",
    "longDescription": "导入网管系统导出的设备参数快照 JSON，按分类查看参数名称、对象标识与当前值，并可导出 CSV 表格。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ZhiPenTu/param-snapshot-viewer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MEU0MjZEQTI4NDJGRjEKUldUeEw0U2liVUlPZGV2cFFjeDlyWEpqK1FHWG5nV1d0SGFuaC90a0VZclphMHFyZCt3d1BkSTcK"
    }
  }
}
